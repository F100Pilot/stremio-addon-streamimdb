# Copy to .env and fill in your values

# External URL exposed by Cloudflare Tunnel (no trailing slash)
SERVER_URL=https://stremio.thehouseofthemaster.pt

# Port the Node.js server listens on (default: 7000)
PORT=7000

# Vaplayer API endpoint (default is fine)
# VAPLAYER_API_URL=https://streamdata.vaplayer.ru/api.php

# Cache TTL in milliseconds (default: 300000 = 5 min)
# CACHE_TTL_MS=300000

# Max concurrent scrapes (default: 8)
# MAX_QUEUE=8

# Segment retry attempts (default: 1)
# MAX_SEG_RETRIES=1

# Health check interval in milliseconds (default: 600000 = 10 min)
# Set to 0 to completely disable health checks
# HEALTH_CHECK_INTERVAL_MS=600000

# Optional: Slack/Discord webhook for health alerts
# ALERT_WEBHOOK=

# ── Alertas Telegram ──────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890

# ── Alertas Email (SMTP) ──────────────────────────────────────────
# Para Gmail: SMTP_PASS = App Password (não a password normal)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=teu-email@gmail.com
# SMTP_PASS=app-password-16-chars
# ALERT_EMAIL=destinatario@gmail.com   # default = SMTP_USER

# ── Segurança do proxy HLS (C1) ───────────────────────────────────
# Segredo para assinar os tokens do proxy (HMAC). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PROXY_SECRET=

# ── Legendas externas (OpenSubtitles) ─────────────────────────────
# Só se aplica a streams SEM legendas próprias (ex.: VidSrc). Fontes com
# legendas no manifesto (VixSrc) nunca são tocadas.
# OPENSUBTITLES=off            # desliga por completo
# OPENSUBTITLES_LANGS=por,pob,eng  # ISO 639-2; pob = PT-BR. Ordem = ordem na lista
# OPENSUBTITLES_MAX=3          # nº de candidatas por idioma
# OPENSUBTITLES_UA=            # User-Agent registado, se tiveres um
# OPENSUBTITLES_TIMEOUT_MS=8000

# ── Resolver por browser (browser_resolver.js) ────────────────────
# Substituiu o vidsrc_resolver: tenta uma lista de fontes em sequência em vez
# de só o vidsrc.in. Se tinhas VIDSRC_* no .env, os nomes mudaram para BROWSER_*.
#
# Lista/ordem das fontes. Vazio = todas as da lista PROVIDERS.
# SÓ o vidsrc.in está comprovado; descobre quais das outras prestam com:
#   node diag_browser_sources.js
# e cola aqui a linha que ele imprime no fim.
# BROWSER_PROVIDERS=vidsrc.in
#
# BROWSER_CONCURRENCY=2          # resoluções em paralelo
# BROWSER_PROVIDER_MS=25000      # tempo máx. por fonte antes de passar à seguinte
# BROWSER_NAV_TIMEOUT_MS=30000
# BROWSER_IDLE_CLOSE_MS=300000   # fecha o browser após inatividade
# BROWSER_CB_THRESHOLD=5         # falhas seguidas antes do circuit breaker
# BROWSER_CB_COOLDOWN_MS=600000
# BROWSER_HEADLESS=new           # 'false' só para ver o browser a trabalhar
# BROWSER_PROXYABLE=true         # nesta branch fica true: o servidor tem o IP bom
# BROWSER_DEBUG=1                # despeja rede, frames e erros da página
